{
  "name": "obsidian-learning-coach",
  "version": "0.4.2",
  "private": true,
  "description": "A note-grounded learning coach for Obsidian",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "build": "npm run typecheck && node esbuild.config.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "test:e2e": "npm run build && node scripts/obsidian-e2e.mjs",
    "release:check": "npm run package && node scripts/release-check.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "obsidian": "^1.13.1",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
